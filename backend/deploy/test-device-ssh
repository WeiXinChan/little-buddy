#!/usr/bin/env python3
"""Run only inside the disposable mount, PID and network namespaces in the runbook."""
from contextlib import contextmanager
import hashlib
import os
from pathlib import Path
import shutil
import socket
import ssl
import subprocess
import tempfile
import time

HERE = Path(__file__).resolve().parent
USER = "little-buddy-device"
ADMIN = "buddy-fixture-admin"
SSHD = "/usr/sbin/sshd"
STATE = Path("/etc/little-buddy-ssh")


def run(*args, success=True):
    result = subprocess.run(args, capture_output=True, text=True, timeout=25)
    if (result.returncode == 0) != success:
        raise AssertionError(f"{args}: {result.returncode}\n{result.stdout}{result.stderr}")
    return result


@contextmanager
def process(*args):
    child = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        yield child
    finally:
        if child.poll() is None:
            child.terminate()
        try:
            child.wait(timeout=3)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()


def wait_port(port, child):
    for _ in range(100):
        assert child.poll() is None, f"listener exited on {port}"
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.2):
                return
        except OSError:
            time.sleep(0.05)
    raise AssertionError(f"listener unavailable on {port}")


def exercise(scratch):
    run("mount", "--make-rprivate", "/")
    run("ip", "link", "set", "lo", "up")
    upper, work = scratch / "upper", scratch / "work"
    upper.mkdir()
    work.mkdir()
    run("mount", "-t", "overlay", "overlay", "-o",
        f"lowerdir=/etc,upperdir={upper},workdir={work}", "/etc")
    assert not STATE.exists(), "fixture host already has a device state directory"
    state_home = STATE / "home"
    STATE.mkdir(mode=0o755)
    state_home.mkdir(mode=0o755)
    admin_home = scratch / "admin-home"
    admin_home.mkdir(mode=0o700)
    ssh_home = admin_home / ".ssh"
    ssh_home.mkdir(mode=0o700)
    os.chown(admin_home, 48002, 48002)
    os.chown(ssh_home, 48002, 48002)
    for file, lines in {
        "passwd": [f"{USER}:x:48001:48001::{state_home}:/usr/sbin/nologin",
                   f"{ADMIN}:x:48002:48002::{admin_home}:/bin/sh"],
        "shadow": [f"{user}:!:20000:0:99999:7:::" for user in (USER, ADMIN)],
        "group": [f"{USER}:x:48001:", f"{ADMIN}:x:48002:"],
    }.items():
        original = Path("/etc") / file
        copied = scratch / file
        if file == "shadow":
            copied.touch(mode=0o600)
        else:
            shutil.copyfile(original, copied)
            copied.chmod(0o644)
        with copied.open("a") as output:
            output.write("\n".join(lines) + "\n")
        run("mount", "--bind", copied, original)

    def key(name, kind, bits):
        target = scratch / name
        run("ssh-keygen", "-q", "-t", kind, "-b", bits, "-N", "", "-f", target)
        return target

    host = key("host", "ecdsa", "256")
    wrong_host = key("wrong-host", "ecdsa", "256")
    device = key("device", "rsa", "2048")
    unknown = key("unknown", "rsa", "2048")
    admin = key("admin", "rsa", "2048")
    admin_keys = ssh_home / "authorized_keys"
    shutil.copyfile(f"{admin}.pub", admin_keys)
    admin_keys.chmod(0o600)
    os.chown(admin_keys, 48002, 48002)
    fingerprint = run("ssh-keygen", "-lf", f"{device}.pub").stdout.split()[1]

    def known_hosts(identity):
        known = identity.with_suffix(".known")
        known.write_text("127.0.0.1 " + identity.with_suffix(".pub").read_text())
        return known

    known = known_hosts(host)
    wrong_known = known_hosts(wrong_host)
    baseline = scratch / "baseline.conf"
    baseline.write_text(f"Port 22\nListenAddress 127.0.0.1\nHostKey {host}\n"
                        f"PidFile {scratch}/sshd.pid\nUsePAM yes\nUseDNS no\n"
                        "LoginGraceTime 3\nPasswordAuthentication no\n"
                        "Subsystem sftp internal-sftp\n")
    candidate = scratch / "candidate.conf"
    candidate.write_text(baseline.read_text() +
                         f"Include {HERE / 'little-buddy-device.conf'}\n")
    control = [HERE / "device-ssh", "--config", candidate]
    print(run(*control, "check", baseline, candidate, "192.0.2.5,198.51.100.8").stdout.strip())

    def ssh(key_path=device, account=USER, known_file=known):
        return ["ssh", "-F", "/dev/null", "-oBatchMode=yes", "-oIdentitiesOnly=yes",
                "-oStrictHostKeyChecking=yes", "-oGlobalKnownHostsFile=/dev/null",
                f"-oUserKnownHostsFile={known_file}", "-oHostKeyAlgorithms=ecdsa-sha2-nistp256",
                "-oPubkeyAcceptedAlgorithms=rsa-sha2-256", "-oConnectTimeout=3",
                "-oExitOnForwardFailure=yes", "-i", key_path, "-l", account]

    tls_key = scratch / "tls.key"
    cert = scratch / "tls.pem"
    wrong_cert = scratch / "wrong.pem"
    for label, pem, private in (("fixture", cert, tls_key),
                                ("wrong", wrong_cert, scratch / "wrong.key")):
        run("openssl", "req", "-x509", "-newkey", "rsa:2048", "-noenc", "-days", "1",
            "-subj", f"/CN={label}", "-addext", "subjectAltName=IP:127.0.0.1",
            "-keyout", private, "-out", pem)

    def https(authority, name):
        context = ssl.create_default_context(cafile=str(authority))
        with socket.create_connection(("127.0.0.1", 19442), timeout=3) as raw:
            with context.wrap_socket(raw, server_hostname=name) as conn:
                conn.sendall(b"GET / HTTP/1.0\r\n\r\n")
                assert b"200 ok" in conn.recv(1024).lower()

    def auth_rejected(*args, expected="Permission denied (publickey)"):
        result = run(*args, "-W", "127.0.0.1:19443", "127.0.0.1", success=False)
        assert expected in result.stderr, result.stderr

    def allowed_channel():
        return [*ssh(), "-N", "-L", "127.0.0.1:19442:127.0.0.1:19443", "127.0.0.1"]

    with process("openssl", "s_server", "-accept", "127.0.0.1:19443",
                 "-cert", cert, "-key", tls_key, "-www") as tls:
        wait_port(19443, tls)
        with process(SSHD, "-D", "-e", "-f", candidate) as listener:
            wait_port(22, listener)
            auth_rejected(*ssh())
            print(run(*control, "register", f"{device}.pub").stdout.strip())
            assert (STATE / "authorized_keys").stat().st_mode & 0o777 == 0o644
            run(*control, "register", f"{unknown}.pub", success=False)
            run(*control, "revoke", run("ssh-keygen", "-lf", f"{unknown}.pub").stdout.split()[1],
                success=False)
            auth_rejected(*ssh(unknown))
            result = run(*ssh(known_file=wrong_known), "127.0.0.1", "true", success=False)
            assert "Host key verification failed" in result.stderr
            for flags in (["-tt", "127.0.0.1"], ["127.0.0.1", "true"],
                          ["-s", "127.0.0.1", "sftp"],
                          ["-N", "-R", "19444:127.0.0.1:19443", "127.0.0.1"],
                          ["-W", "127.0.0.1:19444", "127.0.0.1"],
                          ["-W", "localhost:19443", "127.0.0.1"]):
                outcome = run(*ssh(), *flags, success=False)
                assert "Permission denied (publickey)" not in outcome.stderr
            print("PASS empty slot, unknown key, conflicting fingerprint, wrong host pin, "
                  "shell/PTY/exec/subsystem, reverse and alternate destination")

        with process(SSHD, "-D", "-e", "-f", candidate) as restarted:
            assert restarted.pid != listener.pid
            wait_port(22, restarted)
            admin_socket = scratch / "admin.sock"
            with process(*ssh(admin, ADMIN), "-M", "-S", admin_socket, "-N", "127.0.0.1") as manager:
                for _ in range(100):
                    if admin_socket.exists():
                        break
                    time.sleep(0.05)
                assert manager.poll() is None and admin_socket.exists()
                with process(*allowed_channel()) as forward:
                    wait_port(19442, forward)
                    https(cert, "127.0.0.1")
                    for authority, name in ((wrong_cert, "127.0.0.1"), (cert, "127.0.0.2")):
                        try:
                            https(authority, name)
                        except ssl.SSLCertVerificationError:
                            pass
                        else:
                            raise AssertionError("TLS verification unexpectedly succeeded")
                    print("PASS actual sshd process replacement, persisted authorization, "
                          "strict TLS through tunnel, wrong CA and wrong IP rejection")
                    print(run(*control, "revoke", fingerprint).stdout.strip())
                    assert forward.wait(timeout=3) != 0 and manager.poll() is None
                    auth_rejected(*ssh())
                    assert run(*ssh(admin, ADMIN), "-S", admin_socket, "127.0.0.1",
                               "printf management").stdout == "management"
                    assert run(*ssh(admin, ADMIN), "127.0.0.1", "printf fresh").stdout == "fresh"
                    print("PASS server-side drain, old key denied, existing and new management sessions")
            run(*control, "register", f"{device}.pub")
            with process(*allowed_channel()) as forward:
                wait_port(19442, forward)
                https(cert, "127.0.0.1")
                print(run(*control, "rollback").stdout.strip())
                assert forward.wait(timeout=3) != 0
            auth_rejected(*ssh())
        with process(SSHD, "-D", "-e", "-f", baseline) as restored:
            wait_port(22, restored)
            auth_rejected(*ssh(), expected="Permission denied (")
            assert run(*ssh(admin, ADMIN), "127.0.0.1", "printf restored").stdout == "restored"
        assert not (STATE / "authorized_keys").exists()
        audit = (STATE / "audit.log").read_text()
        assert all(marker in audit for marker in ("registered", "revoke-drained", "rollback-drained"))
        print("PASS rollback under active tunnel, baseline restart, persistent audit and empty slot")


if __name__ == "__main__":
    assert os.geteuid() == 0 and os.getpid() == 1, "run as namespace PID 1"
    assert Path("/proc/1/ns/net").readlink() == Path("/proc/self/ns/net").readlink()
    assert [entry.split()[1].rstrip(":") for entry in run("ip", "-o", "link").stdout.splitlines()] == ["lo"]
    with tempfile.TemporaryDirectory(prefix="buddy-device-") as directory:
        scratch = Path(directory)
        scratch.chmod(0o755)
        try:
            exercise(scratch)
        finally:
            for target in ("/etc/group", "/etc/shadow", "/etc/passwd", "/etc"):
                subprocess.run(["umount", target], capture_output=True, check=False)
    for file in ("device-ssh", "little-buddy-device.conf", "test-device-ssh"):
        print(hashlib.sha256((HERE / file).read_bytes()).hexdigest(), file)
