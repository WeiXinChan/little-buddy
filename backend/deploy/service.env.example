# Local-only defaults for rehearsal. Use the externally verified Host (include
# the port unless it is 443) before exposing an ingress route.
LITTLE_BUDDY_BIND=127.0.0.1
LITTLE_BUDDY_PORT=19443
LITTLE_BUDDY_AUTHORITY=127.0.0.1:19443
DASHSCOPE_WORKSPACE=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_ASR_MODEL=fun-asr-realtime
DASHSCOPE_LLM_MODEL=
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_TTS_VOICE=
