[Unit]
Description=Little Buddy V1 standalone voice service
After=network-online.target
Wants=network-online.target
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=exec
DynamicUser=yes
WorkingDirectory=/opt/little-buddy-v1/current
EnvironmentFile=/etc/little-buddy-v1/service.env
LoadCredential=animal-device-token:/etc/little-buddy-v1/device/token
LoadCredential=animal-device-expiry:/etc/little-buddy-v1/device/expiry
LoadCredential=dashscope-api-key:/etc/little-buddy-v1/dashscope-api-key
LoadCredential=tls-certificate:/etc/little-buddy-v1/tls/fullchain.pem
LoadCredential=tls-private-key:/etc/little-buddy-v1/tls/privkey.pem
ExecStart=/opt/little-buddy-v1/current/.venv/bin/python -B -m backend.animal.cloud --standalone --port ${LITTLE_BUDDY_PORT} --cert %d/tls-certificate --key %d/tls-private-key
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
MemoryMax=256M
MemorySwapMax=0
LimitCORE=0
TasksMax=32
LogRateLimitIntervalSec=30s
LogRateLimitBurst=300

[Install]
WantedBy=multi-user.target
