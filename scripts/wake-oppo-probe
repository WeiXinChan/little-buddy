#!/usr/bin/env bash
# Run from the verified handoff bundle. Only the fresh, isolated test packages are modified.
set -euo pipefail

if [[ $# != 4 ]]; then
    echo "Usage: $0 SERIAL SSH_ALIAS REMOTE_BUNDLE RESULT_DIR" >&2
    exit 2
fi
serial=$1
host=$2
remote=$3
results=$4
[[ "$host" != -* && "$remote" =~ ^/home/ubuntu/tech/tita42/[0-9a-f]{40}$ ]]
[[ ! -e "$results" ]]
mkdir -m 700 "$results"

adb=(adb -s "$serial")
app=com.littlebuddy.sim.wakeprobe
test=$app.test
runner=$test/com.littlebuddy.SimUiRunner
port=19446
run_id="$(date +%s)-$$"
app_owned=
test_owned=
reverse_owned=
fixture_pid=

stop_fixture() {
    if [[ -n "$fixture_pid" ]]; then
        kill -TERM "$fixture_pid" 2>/dev/null || true
        wait "$fixture_pid" 2>/dev/null || true
        fixture_pid=
    fi
}

cleanup() {
    local result=$?
    trap - EXIT
    set +e
    stop_fixture
    if [[ -n "$reverse_owned" ]]; then "${adb[@]}" reverse --remove "tcp:$reverse_owned"; fi
    if [[ -n "$test_owned" ]]; then "${adb[@]}" uninstall "$test"; fi
    if [[ -n "$app_owned" ]]; then "${adb[@]}" uninstall "$app"; fi
    printf '%s\n' "$result" > "$results/exit-status.txt"
    exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

shasum -a 256 -c SHA256SUMS | tee "$results/hashes.txt"
scripts/check-wake-fixtures wake-probe-test.apk | tee "$results/fixtures.txt"
build_tools="${ANDROID_HOME:-$HOME/Library/Android/sdk}/build-tools/35.0.0"
for entry in "wake-probe.apk:$app" "wake-probe-test.apk:$test"; do
    apk=${entry%:*}
    package=${entry#*:}
    "$build_tools/aapt" dump badging "$apk" > "$results/$apk.manifest"
    head -1 "$results/$apk.manifest" | grep -F "package: name='$package' "
    "$build_tools/apksigner" verify --verbose --print-certs "$apk" > "$results/$apk.signer"
    grep -F 'Signer #1 certificate SHA-256 digest:' "$results/$apk.signer"
done
for field in ro.product.model ro.build.version.sdk ro.product.cpu.abilist; do
    printf '%s=' "$field"
    "${adb[@]}" shell getprop "$field" | tr -d '\r'
done > "$results/device.txt"
grep -E '^ro.product.cpu.abilist=(arm64-v8a)(,|$)' "$results/device.txt"
[[ "$("${adb[@]}" shell am get-current-user | tr -d '\r')" == 0 ]]
installed=$("${adb[@]}" shell pm list packages -u --user 0 "$app" | tr -d '\r')
if grep -Eq "^package:com[.]littlebuddy[.]sim[.]wakeprobe([.]test)?$" <<< "$installed"; then
    echo 'Isolated probe package already exists. Installation refused.' >&2
    exit 1
fi
reverse_entries=$("${adb[@]}" reverse --list)
for candidate in 19446 19447; do
    if awk -v endpoint="tcp:$candidate" '$2==endpoint || $3==endpoint {found=1} END {exit !found}' <<< "$reverse_entries"; then
        echo "ADB reverse port already in use: $candidate" >&2
        exit 1
    fi
done
"${adb[@]}" install -g wake-probe.apk
app_owned=1
"${adb[@]}" install -t wake-probe-test.apk
test_owned=1
start_fixture() {
    local scenario=$1 logfile="$results/$1.fixture.txt"
    "${adb[@]}" reverse --no-rebind "tcp:$port" "tcp:$port"
    reverse_owned=$port
    ssh -tt -o BatchMode=yes -o ExitOnForwardFailure=yes         -L "127.0.0.1:$port:127.0.0.1:$port" "$host"         "cd '$remote' && LITTLE_BUDDY_FIXTURE_PORT=$port ./scripts/with-private-animal fixture $scenario"         > "$logfile" 2>&1 &
    fixture_pid=$!
    for _ in {1..40}; do
        kill -0 "$fixture_pid" 2>/dev/null || break
        if grep -Fq "animal_fixture_ready scenario=$scenario port=$port" "$logfile"; then return 0; fi
        sleep 0.25
    done
    echo "Fixture failed to start: $scenario" >&2
    return 1
}

run_case() {
    local label=$1 method=$2
    shift 2
    "${adb[@]}" shell pm clear --user 0 "$app" | tr -d '\r' | grep -Fx Success
    "${adb[@]}" shell pm grant --user 0 "$app" android.permission.RECORD_AUDIO
    perl -e 'alarm shift; exec @ARGV' 100 "${adb[@]}" shell am instrument -w -r         -e class "com.littlebuddy.BuddyActivityTest#$method"         -e animalUrl "wss://127.0.0.1:$port/v1/animal" -e wakeRun "$run_id" "$@" "$runner"         | tr -d '\r' | tee "$results/$label.instrumentation.txt"
    grep -Fxq 'OK (1 test)' "$results/$label.instrumentation.txt"
    ! grep -Eq '^INSTRUMENTATION_STATUS_CODE: -[1-4]$' "$results/$label.instrumentation.txt"
}

verify_fixture() {
    local scenario=$1 connections=$2 recognized=$3
    tr -d '\r' < "$results/$scenario.fixture.txt" > "$results/$scenario.events.txt"
    local logfile="$results/$scenario.events.txt"
    [[ $(grep -c '^wake_fixture_connection$' "$logfile") == "$connections" ]]
    [[ $(grep -c '^wake_fixture_first_pcm turn=[0-9][0-9]*$' "$logfile") == "$recognized" ]]
    [[ $(grep -c '^wake_fixture_pcm turn=[0-9][0-9]* exact=1$' "$logfile") == "$recognized" ]]
    ! grep -q 'exact=0' "$logfile"
}

start_fixture wake
run_case flow nativeWakeFlowsThroughProductAudioAndTlsAsr
verify_fixture wake 2 2
stop_fixture
"${adb[@]}" reverse --remove "tcp:$reverse_owned"
reverse_owned=

port=19447
start_fixture wake-revoke
for revoke in stop background sleep; do
    for gate in WAKE_COMMAND ASR_READY PCM_SEGMENT; do
        run_case "$revoke-$gate" nativeWakeRejectsRevokedCallbacks -e wakeGate "$gate" -e wakeRevoke "$revoke"
    done
done
verify_fixture wake-revoke 6 3
"${adb[@]}" logcat -d -t 1000 -s WakeProbe:I | grep -F "run=$run_id " > "$results/screen-state.txt"
[[ $(wc -l < "$results/screen-state.txt") -eq 3 ]]
